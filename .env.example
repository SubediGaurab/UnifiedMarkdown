# UnifiedMarkdown settings. Copy to ~/.umd/.env (chmod 600).
# This file is the only source of truth: umd has no built-in default
# models and no provider fallbacks. A missing value stops umd with an
# error naming the variable.

# Gemini (used for every conversion unless --use-openai is passed)
GEMINI_API_KEY=
GEMINI_OCR_MODEL=
GEMINI_TEXT_MODEL=

# OpenAI compatible endpoint (only used with --use-openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_OCR_MODEL=
OPENAI_TEXT_MODEL=
